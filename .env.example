# ---------------------------------------------------------------------------
# Umgebungsvariablen – baryton-website
# ---------------------------------------------------------------------------
# Die GitHub-Pages-Demo braucht KEINE dieser Variablen. Alles hier ist nur für die
# spätere Umstellung auf Sanity (CMS) und Vercel (Hosting) vorgesehen.
# Kopie als `.env.local` anlegen (wird nicht committet). Keine echten Werte hier eintragen.

# --- Betriebsart -------------------------------------------------------------
# "vercel" schaltet Server-Rendering, Studio unter /studio, Vorschau und ISR ein.
# Fehlt die Variable oder ist sie leer, wird ein statischer Export für GitHub Pages gebaut.
DEPLOY_TARGET=

# Öffentliche URL der Website (ohne Schrägstrich am Ende). Wird für Canonical-Links,
# Open Graph und JSON-LD verwendet. Auf Vercel z. B. https://baryton-website.vercel.app,
# nach dem Domain-Umzug die Kundendomain (baryton.ch ist registriert, liefert aber derzeit keine Website aus). Leer = Standard je Betriebsart.
SITE_URL=

# Nur für GitHub Pages: Unterpfad des Repositories (Standard, wenn nicht gesetzt: /baryton-website).
# Nur einkommentieren und leer setzen (BASE_PATH=), wenn der Export an einer Domain-Wurzel liegen soll.
# BASE_PATH=

# Suchmaschinen-Indexierung erlauben (nur nach Go-Live auf der Kundendomain auf "1" setzen).
# Solange leer, bekommen alle Seiten `noindex`.
INDEXIERUNG=

# --- Inhalte -----------------------------------------------------------------
# "sanity" liest die Inhalte aus Sanity; alles andere (oder leer) liest data/*.json.
# Ist "sanity" gesetzt, MÜSSEN Projekt-ID und Dataset vorhanden sein, sonst bricht der Build
# mit einer klaren Fehlermeldung ab (kein stiller Rückfall auf Demo-Inhalte).
CONTENT_SOURCE=

# --- Sanity (öffentliche Werte, keine Geheimnisse) ---------------------------
# Projekt-ID aus https://www.sanity.io/manage (z. B. abcd1234)
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset, in der Regel "production"
NEXT_PUBLIC_SANITY_DATASET=production
# Fixe API-Version (Datum), damit Abfragen stabil bleiben
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-17

# --- Sanity (GEHEIM – nur in .env.local bzw. in den Vercel-Umgebungsvariablen) ---
# Token mit Rolle "Viewer" für die Entwurfsvorschau (Draft Mode / Visual Editing)
SANITY_API_READ_TOKEN=
# Token mit Rolle "Editor" – nur für das Importskript `npm run seed`
SANITY_API_WRITE_TOKEN=
# Frei gewähltes Geheimnis; muss identisch im Sanity-Webhook (Manage → API → Webhooks) stehen.
# Ohne dieses Geheimnis wird kein Webhook angenommen.
SANITY_REVALIDATE_SECRET=
